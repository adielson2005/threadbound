<?xml version="1.0" encoding="utf-8"?>
<!-- Threadbound para Android: uma Activity em tela cheia com uma WebView que roda o jogo dos
     arquivos dentro do próprio APK (assets/www), sem precisar de internet. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.adielson.threadbound"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />
    <!-- WebGL 2 precisa de GPU com OpenGL ES 3 -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:label="Threadbound"
        android:icon="@drawable/icone"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:theme="@style/Tema">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
